  "name": "@skyfalcode/electron-forge-maker-inno-setup",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Skyfalcode/electron-forge-maker-inno-setup.git"
  },
  "scripts": {
