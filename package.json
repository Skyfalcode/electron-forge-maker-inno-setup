  },
  "description": "Electron Forge maker that builds Windows installers using Inno Setup (ISCC).",
  "dependencies": {
    "@electron-forge/maker-base": "^7.10.2",
    "@skyfalcode/inno-setup": "^1.0.0"
  },
  "devDependencies": {
    "@types/node": "^25.0.3",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">= 16.4.0"
  },
  "exports": {
    ".": {
      "types": "./dist/MakerInnoSetup.d.ts",
